{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 4 * * 1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  }
}

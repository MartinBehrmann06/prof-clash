# Supabase → Project Settings → API (or "Connect" button)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the public "anon" / "publishable" key — safe to expose to browsers
SUPABASE_ANON_KEY=

# Supabase → Connect → "Session pooler" connection string (replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-eu-central-2.pooler.supabase.com:5432/postgres

# shown in the Impressum / Datenschutz pages (set these in Vercel too)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_PLACE=
NEXT_PUBLIC_CONTACT_EMAIL=

PORT=3000
